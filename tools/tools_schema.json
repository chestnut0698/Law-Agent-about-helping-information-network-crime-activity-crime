            "type": "string",
            "description": "条号，如'第一条'或'577'。仅 get_clause 操作使用"
          },
          "keyword": {
            "type": "string",
            "description": "检索关键词，如'合同'、'违约责任'。仅 search 操作使用"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
