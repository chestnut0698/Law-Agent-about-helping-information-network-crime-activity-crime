  {
    "type": "function",
    "function": {
      "name": "search_lawlibrary",
      "description": "查询本地法律法规库（docx文件）。可列出所有法规、获取指定条文、关键词检索。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "get_clause",
              "search"
            ],
            "description": "操作类型：list=列出所有法规, get_clause=获取条文, search=关键词检索"
          },
          "law_title": {
            "type": "string",
            "description": "法规标题关键词，如'民法典'、'劳动法'。list 操作时无需此参数"
          },
          "clause": {
            "type": "string",
            "description": "条号，如'第一条'或'577'。仅 get_clause 操作使用"
          },
          "keyword": {
            "type": "string",
            "description": "检索关键词，如'合同'、'违约责任'。仅 search 操作使用"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_policy",
      "description": "查询本地政策文件库（意见/通知/办法/规定等）。支持列出文件、获取具体段落、关键词检索、获取全文。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "get_section",
              "search",
              "full_text"
            ],
            "description": "操作类型"
          },
          "keyword": {
            "type": "string",
            "description": "文件标题关键词或检索词"
          },
          "section_ref": {
            "type": "string",
            "description": "段落标识，如'一、' '（二）' '第一条'。留空返回目录"
          },
          "policy_type": {
            "type": "string",
            "description": "政策类型过滤：意见/通知/办法/规定/决定"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  }
]