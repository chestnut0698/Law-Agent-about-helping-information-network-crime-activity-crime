# Copy to repository root `.env`. Never commit real secrets.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite + material storage (defaults resolve under repo root if omitted)
# DATABASE_PATH=
# MATERIAL_STORAGE_DIR=
# REDACTION_STORAGE_DIR=

MAX_UPLOAD_BYTES=52428800
OCR_TEXT_DENSITY_THRESHOLD=0.08
OCR_LOW_CONFIDENCE_THRESHOLD=0.75
OCR_MAX_PAGE_RETRIES=2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
PARSER_VERSION=stage3-v1

# 本地演示用 allow_all；生产必须改为 deny_all 并接入真实授权。未设置时 development 默认 allow_all。
MATERIAL_AUTH_MODE=allow_all

# 默认模型链路：DeepSeek。所有模型调用必须经 agents/gateway.py。
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# false 时关闭外呼，系统降级为仅确定性规则；true 且 GATEWAY_FAKE_MODE 时走 Fake 网关。
DEEPSEEK_EXTERNAL_CALLS_ENABLED=true
GATEWAY_FAKE_MODE=false
GATEWAY_TIMEOUT_SECONDS=30
GATEWAY_MAX_RETRIES=3
GATEWAY_RETRY_BASE_SECONDS=0.5
# GATEWAY_MODEL_WHITELIST=deepseek-v4-flash,meta/muse-glimmer-30b

# 可选：队友本地 NVIDIA（仅当未配置 DEEPSEEK_API_KEY 时生效）
# NVIDIA_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_NAME=meta/muse-glimmer-30b

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
